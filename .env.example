# PainRadar — environment variables
#
# Copy this file to .env for local development (pnpm workspaces load env
# vars per-process; see README.md for how each app picks these up). On
# Vercel, set these under Project Settings → Environment Variables instead
# of committing a .env file.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Any standard Postgres connection string. Works with Neon, Supabase,
# Railway, Render, RDS, or a local Postgres instance. Needs a connection
# pooler (e.g. Neon's pooled connection string, or PgBouncer) if deployed
# to a serverless platform like Vercel, since each function invocation can
# open its own connection.
DATABASE_URL=postgres://user:password@host:5432/painradar

# ---------------------------------------------------------------------------
# Clerk authentication (required)
# ---------------------------------------------------------------------------
# This app was originally built with Clerk auth managed through Replit's
# built-in "Auth pane" (no separate Clerk dashboard). Outside Replit, you
# need your own Clerk account and application: https://dashboard.clerk.com
#
# - Create a Clerk application.
# - Copy its Publishable key and Secret key below.
# - The same publishable key is needed in two places because the frontend
#   (Vite) and backend (Express) are built and run separately.
# - In Clerk's dashboard, add your deployed domain(s) under
#   "Domains" / allowed origins once you know your Vercel URL.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Same value as CLERK_PUBLISHABLE_KEY above. Vite only exposes env vars to
# the browser bundle when they are prefixed with VITE_, and only variables
# present at *build* time are baked into the frontend bundle.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Only needed if you configure a Clerk proxy on a custom domain.
# Leave unset otherwise.
# VITE_CLERK_PROXY_URL=

# ---------------------------------------------------------------------------
# Not required
# ---------------------------------------------------------------------------
# PainRadar does not use Reddit, X/Twitter, or Facebook credentials —
# those sources are intentionally not connected (see Settings → Source
# status in the app). Hacker News discovery uses its public, unauthenticated
# Firebase API and needs no credentials.
